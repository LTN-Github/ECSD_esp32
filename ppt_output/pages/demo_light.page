      align: [left, middle]
      wrap: true
      text: |
        <p><span style="color:$primary;">③</span> 调用 GPIO 工具，继电器闭合</p>
  - elementId: left-arrow-3
    elementType: shape
    bounds: [330, 410, 0, 30]
