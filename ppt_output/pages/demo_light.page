pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-accent-bar
    elementType: shape
    bounds: [0, 0, 1280, 4]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#00D4AA00"}
        - {position: 0.3, color: "$primary"}
        - {position: 0.7, color: "$primary"}
        - {position: 1, color: "#00D4AA00"}
  - elementId: corner-bar
    elementType: shape
    bounds: [60, 50, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [80, 48, 600, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>演示②：飞书语音控制灯光</p>
  - elementId: left-col-label
    elementType: text
    bounds: [60, 120, 300, 28]
    content:
      fontSize: 18
      color: "$primary"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>场景：开灯</p>
  - elementId: left-step-bg-1
    elementType: shape
    bounds: [60, 170, 540, 60]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: left-step-text-1
    elementType: text
    bounds: [80, 170, 500, 60]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: true
      text: |
        <p><span style="color:$primary;">①</span> 用户在飞书群发送："打开客厅的灯"</p>
  - elementId: left-arrow-1
    elementType: shape
    bounds: [330, 230, 0, 30]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: left-step-bg-2
    elementType: shape
    bounds: [60, 260, 540, 60]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: left-step-text-2
    elementType: text
    bounds: [80, 260, 500, 60]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: true
      text: |
        <p><span style="color:$primary;">②</span> AI 识别意图：开启客厅照明</p>
  - elementId: left-arrow-2
    elementType: shape
    bounds: [330, 320, 0, 30]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: left-step-bg-3
    elementType: shape
    bounds: [60, 350, 540, 60]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
