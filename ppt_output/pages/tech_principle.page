pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-accent-bar
    elementType: shape
    bounds: [0, 0, 1280, 4]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#00D4AA00"}
        - {position: 0.3, color: "$primary"}
        - {position: 0.7, color: "$primary"}
        - {position: 1, color: "#00D4AA00"}
  - elementId: corner-bar
    elementType: shape
    bounds: [60, 50, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [80, 48, 700, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>技术原理：MimiClaw 纯C嵌入式AI智能体</p>
  - elementId: left-body
    elementType: text
    bounds: [60, 120, 580, 400]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong><span style="color:$primary;">MimiClaw</span></strong>：纯C语言嵌入式AI智能体框架，跑在ESP32-S3上</p>
        <p style="margin-top:16px"><strong>ReAct Agent 循环</strong></p>
        <p>接收消息 → 调用大模型理解意图 → 选择工具 → 执行硬件操作</p>
        <p style="margin-top:16px"><strong>双模型支持</strong></p>
        <p>支持 DeepSeek 和 Claude，运行时可切换</p>
        <p style="margin-top:16px"><strong>端侧红外协议编码</strong></p>
        <p>红外协议在芯片端直接编码，<span style="color:$accent;">不依赖云端码库</span></p>
  - elementId: right-title
    elementType: text
    bounds: [700, 120, 520, 32]
    content:
      fontSize: 20
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>Agent 循环示意图</p>
  - elementId: loop-box-1
    elementType: shape
    bounds: [740, 170, 180, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: loop-text-1
    elementType: text
    bounds: [740, 170, 180, 50]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>接收消息</p>
  - elementId: loop-arrow-1
    elementType: shape
    bounds: [860, 220, 0, 40]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: loop-box-2
    elementType: shape
    bounds: [740, 260, 180, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: loop-text-2
    elementType: text
    bounds: [740, 260, 180, 50]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>LLM 理解意图</p>
  - elementId: loop-arrow-2
    elementType: shape
    bounds: [860, 310, 0, 40]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: loop-box-3
    elementType: shape
    bounds: [740, 350, 180, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: loop-text-3
    elementType: text
    bounds: [740, 350, 180, 50]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>选择工具</p>
  - elementId: loop-arrow-3
    elementType: shape
    bounds: [860, 400, 0, 40]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: loop-box-4
    elementType: shape
    bounds: [740, 440, 180, 50]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: loop-text-4
    elementType: text
    bounds: [740, 440, 180, 50]
    content:
      fontSize: 16
      color: "#000000"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>执行硬件操作</p>
  - elementId: loop-arrow-return
    elementType: shape
    bounds: [960, 220, 100, 220]
    shapeName: bentConnector3
    arrow: ["arrow", null]
    border:
      style: solid
      width: 2
      color: "#FFFFFF30"
  - elementId: loop-note
    elementType: text
    bounds: [960, 160, 240, 50]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>循环最多10轮</p>
        <p>直到 stop_reason = end_turn</p>
  - elementId: tool-title
    elementType: text
    bounds: [700, 520, 520, 32]
    content:
      fontSize: 20
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>已注册工具列表</p>
  - elementId: tool-body
    elementType: text
    bounds: [700, 560, 520, 80]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>web_search | get_current_time | gpio_set/gpio_get</p>
        <p>ir_send / ir_receive | ws2812_on / ws2812_off</p>
        <p>file_read / file_write | cron_add / cron_list</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 680, 1160, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF30"
    opacity: 0.3
  - elementId: bottom-tag
    elementType: text
    bounds: [60, 690, 200, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>MIMICLAW</p>
  - elementId: bottom-page
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>04 / 12</p>
