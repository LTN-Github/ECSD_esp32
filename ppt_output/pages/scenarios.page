pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-accent-bar
    elementType: shape
    bounds: [0, 0, 1280, 4]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#00D4AA00"}
        - {position: 0.3, color: "$primary"}
        - {position: 0.7, color: "$primary"}
        - {position: 1, color: "#00D4AA00"}
  - elementId: corner-bar
    elementType: shape
    bounds: [60, 50, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [80, 48, 600, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>应用场景</p>
  - elementId: card-bg-1
    elementType: shape
    bounds: [60, 120, 270, 480]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: card-icon-1
    elementType: icon
    bounds: [80, 145, 40, 40]
    iconName: "fas:house"
    fill:
      type: solid
      color: "$primary"
  - elementId: card-title-1
    elementType: text
    bounds: [80, 200, 230, 32]
    content:
      fontSize: 20
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>普通家庭</p>
  - elementId: card-divider-1
    elementType: shape
    bounds: [80, 240, 50, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: card-body-1
    elementType: text
    bounds: [80, 260, 230, 300]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>存量家电智能化，无需更换任何设备。红外空调、传统灯具均可接入统一管控。</p>
  - elementId: card-bg-2
    elementType: shape
    bounds: [360, 120, 270, 480]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
