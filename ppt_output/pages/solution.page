pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-accent-bar
    elementType: shape
    bounds: [0, 0, 1280, 4]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#00D4AA00"}
        - {position: 0.3, color: "$primary"}
        - {position: 0.7, color: "$primary"}
        - {position: 1, color: "#00D4AA00"}
  - elementId: corner-bar
    elementType: shape
    bounds: [60, 50, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [80, 48, 600, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>我们的方案</p>
  - elementId: left-body
    elementType: text
    bounds: [60, 120, 580, 280]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong><span style="color:$primary;">一块ESP32-S3芯片（$5）+ 嵌入式AI智能体 + 简单外设 = 全屋智能化</span></strong></p>
        <p style="margin-top:16px">用户在飞书群说一句话 → AI理解意图 → 自动控制家电</p>
        <p style="margin-top:16px">• <strong>不换任何家电</strong>：兼容存量红外/继电器设备</p>
        <p>• <strong>总硬件成本约100元</strong>：远低于全量更换方案</p>
        <p>• <strong>自然语言交互</strong>：无需学习复杂APP操作</p>
  - elementId: kpi-bg
    elementType: shape
    bounds: [60, 420, 600, 100]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: kpi-number
    elementType: text
    bounds: [80, 425, 165, 60]
    content:
      style: "$kpiAccent"
      align: [left, middle]
      wrap: false
      text: |
        <p>~100元</p>
  - elementId: kpi-label
    elementType: text
    bounds: [80, 490, 160, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>总硬件成本</p>
  - elementId: kpi-divider
    elementType: shape
    bounds: [245, 440, 1, 60]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF30"
  - elementId: kpi-number-2
    elementType: text
    bounds: [270, 425, 160, 60]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>$5</p>
  - elementId: kpi-label-2
    elementType: text
    bounds: [270, 490, 160, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>核心芯片</p>
  - elementId: kpi-divider-2
    elementType: shape
    bounds: [440, 440, 1, 60]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF30"
  - elementId: kpi-number-3
    elementType: text
    bounds: [460, 425, 180, 60]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>0元</p>
  - elementId: kpi-label-3
    elementType: text
    bounds: [460, 490, 180, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>设备更换成本</p>
  - elementId: flow-title
    elementType: text
    bounds: [700, 120, 520, 32]
    content:
      fontSize: 20
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>系统架构流程</p>
  - elementId: flow-user
    elementType: shape
    bounds: [700, 170, 140, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 1
      color: "$primary"
  - elementId: flow-user-text
    elementType: text
    bounds: [700, 170, 140, 50]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>用户</p>
  - elementId: arrow-1
    elementType: shape
    bounds: [840, 195, 60, 0]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: flow-feishu
    elementType: shape
    bounds: [900, 170, 140, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 1
      color: "$primary"
  - elementId: flow-feishu-text
