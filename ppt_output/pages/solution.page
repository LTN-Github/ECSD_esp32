    content:
      fontSize: 16
      color: "#000000"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>ESP32-S3</p>
  - elementId: arrow-3
    elementType: shape
    bounds: [1160, 220, 0, 60]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: flow-llm
    elementType: shape
    bounds: [1040, 280, 180, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 1
      color: "$accent"
  - elementId: flow-llm-text
    elementType: text
    bounds: [1040, 280, 180, 50]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>大模型（LLM）</p>
  - elementId: arrow-4
    elementType: shape
    bounds: [1100, 330, 0, 60]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: flow-device
    elementType: shape
    bounds: [1040, 390, 180, 50]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
    border:
      style: solid
      width: 1
      color: "$primary"
  - elementId: flow-device-text
    elementType: text
    bounds: [1040, 390, 180, 50]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>家电执行</p>
  - elementId: flow-desc
    elementType: text
    bounds: [700, 540, 520, 80]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>① 用户在飞书群发送自然语言指令</p>
        <p>② ESP32-S3 接收消息，调用大模型理解意图</p>
        <p>③ 大模型选择工具（红外/继电器/GPIO）</p>
        <p>④ 芯片端直接执行硬件操作，控制家电</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 680, 1160, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF30"
    opacity: 0.3
  - elementId: bottom-tag
    elementType: text
    bounds: [60, 690, 200, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>MIMICLAW</p>
  - elementId: bottom-page
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>03 / 12</p>
