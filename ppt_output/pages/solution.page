      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [center, middle]
      wrap: false
      text: |
        <p>飞书</p>
  - elementId: arrow-2
    elementType: shape
    bounds: [1040, 195, 60, 0]
    shapeName: straightConnector1
    arrow: [null, "arrow"]
    border:
      style: solid
      width: 2
      color: "$primary"
  - elementId: flow-esp32
    elementType: shape
    bounds: [1100, 170, 120, 50]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: flow-esp32-text
