pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-accent-bar
    elementType: shape
    bounds: [0, 0, 1280, 4]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#00D4AA00"}
        - {position: 0.3, color: "$primary"}
        - {position: 0.7, color: "$primary"}
        - {position: 1, color: "#00D4AA00"}
  - elementId: corner-bar
    elementType: shape
    bounds: [60, 50, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: page-title
    elementType: text
    bounds: [80, 48, 600, 44]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>硬件一览：约100元总成本</p>
  - elementId: card-bg-1
    elementType: shape
    bounds: [60, 120, 360, 260]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: card-icon-1
    elementType: icon
    bounds: [80, 140, 48, 48]
    iconName: "fas:microchip"
    fill:
      type: solid
      color: "$primary"
  - elementId: card-title-1
    elementType: text
    bounds: [80, 200, 320, 36]
    content:
      fontSize: 22
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>主控：ESP32-S3</p>
  - elementId: card-divider-1
    elementType: shape
    bounds: [80, 242, 60, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: card-body-1
    elementType: text
    bounds: [80, 256, 320, 100]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>16MB Flash + 8MB PSRAM</p>
        <p>双核 240MHz Xtensa LX7</p>
        <p>Wi-Fi + Bluetooth 5 LE</p>
  - elementId: card-bg-2
    elementType: shape
    bounds: [460, 120, 360, 260]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: card-icon-2
    elementType: icon
    bounds: [480, 140, 48, 48]
    iconName: "fas:tower-broadcast"
    fill:
      type: solid
      color: "$primary"
  - elementId: card-title-2
    elementType: text
    bounds: [480, 200, 320, 36]
    content:
      fontSize: 22
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>红外控制模块</p>
  - elementId: card-divider-2
    elementType: shape
    bounds: [480, 242, 60, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: card-body-2
    elementType: text
    bounds: [480, 256, 320, 100]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>红外发射管 + 接收头</p>
        <p>支持美的/格力空调</p>
        <p>支持红外学习（32组）</p>
  - elementId: card-bg-3
    elementType: shape
    bounds: [860, 120, 360, 260]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: card-icon-3
    elementType: icon
    bounds: [880, 140, 48, 48]
    iconName: "fas:lightbulb"
    fill:
      type: solid
      color: "$primary"
  - elementId: card-title-3
    elementType: text
    bounds: [880, 200, 320, 36]
    content:
      fontSize: 22
      color: "$text"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>灯光控制模块</p>
  - elementId: card-divider-3
    elementType: shape
    bounds: [880, 242, 60, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: card-body-3
    elementType: text
    bounds: [880, 256, 320, 100]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>继电器模块（GPIO控制）</p>
        <p>WS2812 全彩灯带</p>
        <p>成本仅几元</p>
  - elementId: cost-bg
    elementType: shape
    bounds: [60, 420, 1160, 200]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF15"
    border:
      style: solid
      width: 1
      color: "#FFFFFF30"
    shadow:
      blur: 12
      color: "#00000040"
      offset: [0, 4]
  - elementId: cost-label
    elementType: text
    bounds: [80, 440, 300, 28]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      align: [left, middle]
      wrap: false
      text: |
        <p>总BOM成本</p>
  - elementId: cost-number
    elementType: text
    bounds: [80, 470, 300, 80]
    content:
      style: "$kpiAccent"
      align: [left, middle]
      wrap: false
      text: |
        <p>~100元</p>
  - elementId: cost-list
    elementType: text
    bounds: [420, 440, 780, 160]
    content:
      fontSize: 16
      color: "$secondary"
      fontFamily: "Oranienbaum, siyuanSongti"
      lineHeight: 1.8
      align: [left, top]
      text: |
        <p>ESP32-S3 开发板 ........................... ~30元</p>
        <p>红外发射/接收模块 ........................... ~10元</p>
        <p>继电器模块 ................................. ~5元</p>
        <p>WS2812 灯带 ................................. ~15元</p>
        <p>其他（杜邦线、面包板等） ................... ~40元</p>
  - elementId: bottom-line
    elementType: shape
    bounds: [60, 680, 1160, 1]
    shapeName: rect
    fill:
      type: solid
      color: "#FFFFFF30"
    opacity: 0.3
  - elementId: bottom-tag
    elementType: text
    bounds: [60, 690, 200, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>MIMICLAW</p>
  - elementId: bottom-page
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>05 / 12</p>
